1	 	 	 	 	 	 	 	PAGE	60,132
2	 	 	 	 	 	 	 	TITLE	ISX86 - ISIS-II INTERFACE FOR MS-DOS (8086)
3	 	 	 	 	;=======================================================================
4	 	 	 	 	; ISX86.ASM  --  ISIS-II interface (ISX) for the IBM PC / MS-DOS.
5	 	 	 	 	;
6	 	 	 	 	; 8086 rewrite of ISX.ASM (Digital Research ISIS-II INTERFACE VERS 1.4,
7	 	 	 	 	; Kaypro-patched version).  ISX ran ISIS-II 8080 programs (PLM80, ASM80,
8	 	 	 	 	; FORT80, LINK, LOCATE, ...) under CP/M by trapping their ISIS calls at
9	 	 	 	 	; 0040H and the Intellec monitor entries at F800H.  An 8086 cannot run
10	 	 	 	 	; 8080 code, so this version carries an 8080 interpreter; the ISIS layer
11	 	 	 	 	; reproduces ISX's behaviour on MS-DOS handle calls instead of the CP/M
12	 	 	 	 	; BDOS:  prompt "n>", internal commands DIR/ERA/TYPE/REN/DBUG, absolute
13	 	 	 	 	; OMF-80 loader (content >= 3100H, below MEMTOP), :CI: line buffer
14	 	 	 	 	; positioned after the command name, RESCAN, ISX error codes and the
15	 	 	 	 	; "ERROR nnn, AT USER PC xxxx" report.  EXIT returns to DOS.
16	 	 	 	 	;
17	 	 	 	 	; Assemble:  MASM ISX86;      Link:  LINK ISX86;
18	 	 	 	 	;
19	 	 	 	 	; Filename mapping:  :F0:-:F9: all map to the current DOS directory
20	 	 	 	 	; unless overridden with environment variables ISISF0 .. ISISF9, e.g.
21	 	 	 	 	;       SET ISISF1=B:
22	 	 	 	 	;       SET ISISF2=C:\PLM\
23	 	 	 	 	; Use FILES=20 (or more) in CONFIG.SYS.
24	 	 	 	 	;
25	 	 	 	 	; Usage:  ISX86              interactive ISIS command line
26	 	 	 	 	;         ISX86 command      run one ISIS command, then return to DOS
27	 	 	 	 	;=======================================================================
28	 	 	 	 	;
29	 	 	 	 	; 8080 register mapping inside the interpreter:
30	 	 	 	 	;       A=AL  F=AH (8080 PSW bits == 8086 LAHF/SAHF bits)
31	 	 	 	 	;       BC=CX  DE=DX  HL=BX  PC=SI  SP=BP  DS=ES=8080 64K memory segment
32	 	 	 	 	;
33	 = 000D	 	 	 	CR	 	 	EQU	 	0DH
34	 = 000A	 	 	 	LF	 	 	EQU	 	0AH
35	 = F7FF	 	 	 	MEMTOP	 	EQU	 	0F7FFH	 	 	; returned by MEMCK (monitor page a
	 	 	 	t F800H)
36	 = 3100	 	 	 	LDLOW	 	EQU	 	3100H	 	 	; lowest load address (as ISX)
37	 = 3100	 	 	 	STK80	 	EQU	 	3100H	 	 	; initial 8080 SP for a loaded prog
	 	 	 	ram
38	 = 000A	 	 	 	NSLOT	 	EQU	 	10	 	 	 	; AFTN 0..9  (0=:CO: 1=:CI:
	 	 	 	)
39	 = 0050	 	 	 	PLEN	 	EQU	 	80	 	 	 	; DOS path buffer length
40	 	 	 	 	; slot types
41	 = 0000	 	 	 	ST_FREE	 	EQU	 	0
42	 = 0001	 	 	 	ST_DISK	 	EQU	 	1
43	 = 0002	 	 	 	ST_BB	 	EQU	 	2
44	 = 0003	 	 	 	ST_AUXI	 	EQU	 	3
45	 = 0004	 	 	 	ST_AUXO	 	EQU	 	4
46	 = 0005	 	 	 	ST_PRN	 	EQU	 	5
47	 = 0006	 	 	 	ST_CO	 	EQU	 	6
48	 = 0007	 	 	 	ST_CI	 	EQU	 	7
49	 	 	 	 	; trap numbers (ED nn)
50	 = 0000	 	 	 	TR_ISIS	 	EQU	 	0
51	 = 000D	 	 	 	TR_EXIT	 	EQU	 	13
52	 = 000E	 	 	 	TR_BRK	 	EQU	 	14
53	 	 	 	 	
